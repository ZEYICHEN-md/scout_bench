# Chinese Founder Screener — 环境变量配置
# 复制本文件为 .env，填入你的 API keys，可以放入备用 API keys，系统会轮换使用防止 rate limit。

# Exa API Key
# 注册: https://exa.ai
EXA_API_KEY=your_exa_api_key_here
EXA_API_KEY_SECONDARY=your_exa_api_key_secondary_here

# Tavily API Key
# 注册: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here
TAVILY_API_KEY_SECONDARY=your_tavily_api_key_secondary_here